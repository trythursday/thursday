{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional local Thursday feedback record, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_kind", "workflow_mode", "verification_boundary",
    "consumer_verified", "confirmation_turns", "source_bytes_returned",
    "truncated_tool_results", "repeated_unchanged_reads", "check_runs",
    "failed_check_runs", "expected_red_runs", "input_tokens", "output_tokens"
  ],
  "properties": {
    "schema_version": { "const": 1, "default": 1 },
    "record_kind": { "enum": ["observed", "synthetic_example"], "default": "synthetic_example" },
    "workflow_mode": { "enum": ["standard", "scoped"], "default": "scoped" },
    "verification_boundary": { "enum": ["none", "unit_test", "integration", "deployment", "acceptance"], "default": "none" },
    "consumer_verified": { "type": ["boolean", "null"], "default": null },
    "confirmation_turns": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991, "default": null },
    "source_bytes_returned": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991, "default": null },
    "truncated_tool_results": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991, "default": null },
    "repeated_unchanged_reads": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991, "default": null },
    "check_runs": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991, "default": null },
    "failed_check_runs": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991, "default": null },
    "expected_red_runs": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991, "default": null },
    "input_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991, "default": null },
    "output_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991, "default": null }
  }
}
